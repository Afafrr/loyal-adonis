# Copy to .env.prod and keep the real file outside Git.
DOMAIN=loyalty.example.com

POSTGRES_USER=loyal
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=loyal_production
# URL-encode special characters in the password in this URL.
DATABASE_URL=postgresql://loyal:replace-with-a-long-random-password@db:5432/loyal_production

APP_KEY=replace-with-the-output-of-node-ace-generate-key

# Separate from APP_KEY. Must match the physical tags' key derivation setup.
# For new production tags only: openssl rand -hex 16
NFC_MASTER_KEY=replace-with-a-nonzero-32-character-hex-key
