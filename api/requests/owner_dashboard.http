###
# Owner dashboard API — VS Code REST Client
#
# Start the API before sending these requests.
# REST Client retains the authenticated session cookie for localhost.
# The owner is created by the demo seeder.

@baseUrl = http://localhost:3333/api/v1
@ownerEmail = owner@example.com
@ownerPassword = password123

### Get a CSRF token
# @name csrf
GET http://localhost:3333/up
Accept: application/json

### Sign in as the owner
# @name ownerLogin
POST {{baseUrl}}/users/sign_in
Content-Type: application/json
Accept: application/json
X-CSRF-Token: {{csrf.response.headers.X-CSRF-Token}}

{
  "user": {
    "email": "{{ownerEmail}}",
    "password": "{{ownerPassword}}"
  }
}

### Get the owner dashboard (expected: 200)
# @name ownerDashboard
GET {{baseUrl}}/owner/dashboard
Accept: application/json

### Get the owner dashboard without owner access (expected: 403)
# Sign in as a regular customer before sending this request.
# @name ownerDashboardForbidden
GET {{baseUrl}}/owner/dashboard
Accept: application/json
