###
# NTAG 424 DNA encrypted scan — VS Code REST Client
#
# Start the API before sending the request:
#   npm run dev
#
# This endpoint requires an authenticated session. Sign in through auth.http
# first; REST Client retains its cookies for localhost by default.
# Encrypted PICC data, encrypted file data, and CMAC come from the tag URL.

@baseUrl = http://localhost:3333/api/v1
@piccData = A0381B865380C7C8C6EF42190DDE5E56
@enc = 9692DB303A155945B65F3CE7108BC690
@cmac = A66F57C738769417

### Get a CSRF token for the authenticated session
# @name csrf
GET http://localhost:3333/up
Accept: application/json

### Accept an encrypted NTAG 424 DNA scan and add a stamp
POST {{baseUrl}}/tag_scans
Content-Type: application/json
X-CSRF-Token: {{csrf.response.headers.X-CSRF-Token}}
Accept: application/json

{
  "picc_data": "{{piccData}}",
  "enc": "{{enc}}",
  "cmac": "{{cmac}}"
}

### Inspect an encrypted NTAG 424 DNA scan before registering a new tag (development only)
# This verifies and returns the decrypted UID and read counter. It does not create a tag or stamp.
POST {{baseUrl}}/dev/nfc_tags/inspect
Content-Type: application/json
X-CSRF-Token: {{csrf.response.headers.X-CSRF-Token}}
Accept: application/json

{
  "picc_data": "{{piccData}}",
  "enc": "{{enc}}",
  "cmac": "{{cmac}}"
}
