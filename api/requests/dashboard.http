###############################################################################
# Customer — no business membership, both requests should return 403
###############################################################################

### Refresh CSRF token before customer sign-in
# @name customerCsrf
GET http://localhost:3333/up
Accept: application/json

### Sign in as customer
# @name customerLogin
POST {{baseUrl}}/users/sign_in
Content-Type: application/json
Accept: application/json
X-CSRF-Token: {{customerCsrf.response.headers.X-CSRF-Token}}

{
  "user": {
    "email": "member@example.com",
    "password": "{{password}}"
  }
}

### Get business dashboard as customer (expected: 403)
GET {{baseUrl}}/business/dashboard
Accept: application/json

### Get business dashboard stats as customer (expected: 403)
GET {{baseUrl}}/business/dashboard/stats
Accept: application/json
