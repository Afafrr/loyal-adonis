###
# Loyalty accounts dashboard API — VS Code REST Client
#
# Start the API and sign in through auth.http first. REST Client retains the
# authenticated session cookie for localhost and sends it with this request.
#
# The endpoint returns every company joined by the user. Only the first three
# accounts contain up to two most recently visited locations; later accounts
# return an empty locations array. program.stampCount is the progress on the
# current stamp card.

@baseUrl = http://localhost:3333/api/v1
@loyaltyAccountId = 1

### Get loyalty accounts for the dashboard (expected: 200)
# @name loyaltyAccounts
GET {{baseUrl}}/me/loyalty_accounts
Accept: application/json

### Get loyalty account details (expected: 200)
# Update @loyaltyAccountId with an id returned by the dashboard request.
# @name loyaltyAccountDetails
GET {{baseUrl}}/me/loyalty_accounts/{{loyaltyAccountId}}
Accept: application/json
